# Local Development Configuration
# Copy to .env.local and fill in values
#
# Start Dex: npm run dex:up (Docker) or ../idp/scripts/dex.sh start

# Dex OIDC — identity provider
DEX_ISSUER="http://localhost:5556/dex"
DEX_CLIENT_ID="enopax-platform"
DEX_CLIENT_SECRET="dev-secret"
DEX_GRPC_ADDR="localhost:5557"

# NextAuth
AUTH_SECRET=""  # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Application
DATA_DIR="./data"
NEXT_PUBLIC_META_DESC="Cloud hosting and storage platform"

# Email (optional — verification links logged to console if not set)
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="noreply@enopax.com"

# Resource API (optional)
# RESOURCE_API_URL="http://localhost:3001"
# RESOURCE_API_KEY=""
